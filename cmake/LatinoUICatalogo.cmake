# Un modelo de catalogo y un adaptador a la E/S de Latino-Core.
add_library(latino_ui_catalogo STATIC src/ui/ui_catalogo.c src/ui/ui_catalogo_archivo.c src/ui/ui_catalogo_lock.c src/ui/ui_edicion.c src/ui/ui_utf8.c)
target_include_directories(latino_ui_catalogo PUBLIC "${PROJECT_SOURCE_DIR}/include" PRIVATE "${LATINO_INCLUDE_DIR}")
target_link_libraries(latino_ui_catalogo PUBLIC "${LATINO_LIBRARY}")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    target_compile_definitions(latino_ui_catalogo PRIVATE _POSIX_C_SOURCE=200809L)
endif()
add_library(latino_ui_biblioteca STATIC src/ui/ui_biblioteca.c)
target_include_directories(latino_ui_biblioteca PUBLIC "${PROJECT_SOURCE_DIR}/include" "${LATINO_INCLUDE_DIR}")
target_link_libraries(latino_ui_biblioteca PUBLIC latino_ui_catalogo latino_ui_runtime m)
target_link_libraries(host_ui PRIVATE latino_ui_biblioteca)
if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(latino_ui_catalogo PRIVATE -Wall -Wextra -Wpedantic)
    target_compile_options(latino_ui_biblioteca PRIVATE -Wall -Wextra -Wpedantic)
endif()
if(BUILD_TESTING AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
    add_executable(test_ui_catalogo tests/test_ui_catalogo.c)
    target_include_directories(test_ui_catalogo PRIVATE "${LATINO_INCLUDE_DIR}")
    target_link_libraries(test_ui_catalogo PRIVATE latino_ui_catalogo)
    foreach(caso estados lector limites archivo)
        add_test(NAME latino_ui_catalogo_${caso} COMMAND test_ui_catalogo ${caso})
        set_tests_properties(latino_ui_catalogo_${caso} PROPERTIES TIMEOUT 30)
    endforeach()
    add_executable(test_ui_biblioteca tests/test_ui_biblioteca.c)
    target_include_directories(test_ui_biblioteca PRIVATE "${PROJECT_SOURCE_DIR}/tests/soporte_host")
    target_link_libraries(test_ui_biblioteca PRIVATE latino_ui_biblioteca latino_ui_runtime latino_ui_callbacks latino_ui_despachador m)
    add_test(NAME latino_ui_biblioteca_integracion COMMAND test_ui_biblioteca "${PROJECT_SOURCE_DIR}/tests/datos/biblioteca12_compat.lat")
    set_tests_properties(latino_ui_biblioteca_integracion PROPERTIES TIMEOUT 60)
endif()

if(BUILD_TESTING AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
    add_executable(test_ui_edicion tests/test_ui_edicion.c)
    target_link_libraries(test_ui_edicion PRIVATE latino_ui_catalogo)
    add_test(NAME latino_ui_edicion_modelo COMMAND test_ui_edicion)
    add_executable(test_ui_catalogo_lock tests/test_ui_catalogo_lock.c)
    target_link_libraries(test_ui_catalogo_lock PRIVATE latino_ui_catalogo)
    add_test(NAME latino_ui_catalogo_dos_procesos COMMAND test_ui_catalogo_lock)
    set_tests_properties(latino_ui_edicion_modelo latino_ui_catalogo_dos_procesos PROPERTIES TIMEOUT 30)
endif()

if(BUILD_TESTING AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
    add_executable(test_ui_edicion_host tests/test_ui_edicion_host.c)
    target_include_directories(test_ui_edicion_host PRIVATE "${PROJECT_SOURCE_DIR}/tests/soporte_host")
    target_link_libraries(test_ui_edicion_host PRIVATE latino_ui_biblioteca latino_ui_callbacks latino_ui_despachador m)
    add_test(NAME latino_ui_edicion_host COMMAND test_ui_edicion_host "${PROJECT_SOURCE_DIR}/scripts/app_biblioteca.lat")
    set_tests_properties(latino_ui_edicion_host PROPERTIES TIMEOUT 30)
endif()
