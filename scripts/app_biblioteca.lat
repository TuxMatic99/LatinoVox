# Biblioteca13: interfaz y acciones en Latino; un solo catalogo en biblioteca.*.
# Ruta relativa al directorio privado elegido por probar_biblioteca_ui.sh.
ui.titulo("Biblioteca13 - LatinoUI")
ui.iniciar_columna(5)
    ui.etiqueta_id(300, "Biblioteca")
    ui.iniciar_fila(8)
        ui.etiqueta("Buscar")
        ui.campo_texto(100, "")
        ui.boton(210, "Buscar")
        ui.boton(211, "Anterior")
        ui.boton(212, "Siguiente")
    ui.fin_contenedor()
    ui.iniciar_fila(8)
        ui.etiqueta("Codigo")
        ui.campo_texto(101, "")
        ui.etiqueta("Anio")
        ui.campo_texto(104, "")
    ui.fin_contenedor()
    ui.iniciar_fila(8)
        ui.etiqueta("Titulo")
        ui.campo_texto(102, "")
    ui.fin_contenedor()
    ui.iniciar_fila(8)
        ui.etiqueta("Autor")
        ui.campo_texto(103, "")
    ui.fin_contenedor()
    ui.iniciar_fila(8)
        ui.boton(213, "Nuevo")
        ui.boton(201, "Registrar")
        ui.boton(202, "Actualizar")
        ui.boton(203, "Eliminar")
        ui.boton(204, "Cancelar")
    ui.fin_contenedor()
    ui.iniciar_fila(5)
        ui.boton(205, "Confirmar borrado")
        ui.boton(206, "Guardar y seguir")
        ui.boton(207, "Descartar")
    ui.fin_contenedor()
    ui.iniciar_fila(5)
        ui.boton(208, "Continuar editando")
        ui.boton(209, "Cerrar con aviso")
    ui.fin_contenedor()
    ui.etiqueta_id(303, "Sin cambios")
    ui.etiqueta_id(304, "Disco: sin advertencia pendiente.")
    ui.etiqueta_id(302, "Preparando catalogo.")
ui.fin_contenedor()

# Las decisiones y borradores viven en C; Latino declara la pantalla y conecta
# acciones. No se consulta ui.texto() ni se crean cadenas por cada tecla.
funcion __ui_despachar()
    atendido = biblioteca.accion(ui_cb.id_actual(), ui_cb.tipo_actual())
fin
resultado_apertura = biblioteca.abrir("catalogo-v1.tsv")
proteccion_activa = biblioteca.activar_edicion()
