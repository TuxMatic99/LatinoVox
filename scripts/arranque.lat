semilla = motor.semilla()
modo = motor.modo_carga()

// ============================================================================
// MODO 0: REGISTRO DE 20 NODOS, BIOMAS, EJÉRCITO DE GÓLEMS Y FRONTEND (v0.8)
// ============================================================================
si (modo == 0)
    escribir("==================================================")
    escribir("[Latino-Sandbox] Iniciando LatinoVox & UI v0.8...")
    escribir("==================================================")

    // 1. Registro dinámico de bloques (IDs 0 al 19)
    motor.registrar_nodo(0,  "Pasto",          175, 215, 155, 0)
    motor.registrar_nodo(1,  "Piedra",         105, 110, 120, 1)
    motor.registrar_nodo(2,  "Agua",            55, 145, 220, 1)
    motor.registrar_nodo(3,  "Cartel",         145,  95,  50, 0)
    motor.registrar_nodo(4,  "Árbol",           35, 115,  50, 1)
    motor.registrar_nodo(5,  "Camino",         210, 180, 140, 0)
    motor.registrar_nodo(6,  "Arena",          238, 222, 155, 0)
    motor.registrar_nodo(7,  "Lava",           235,  75,  30, 1)
    motor.registrar_nodo(8,  "Puente Madera",  170, 120,  70, 0)
    motor.registrar_nodo(9,  "Ladrillo",       165,  65,  55, 1)
    motor.registrar_nodo(10, "Puerta Cerrada", 125,  75,  35, 1)
    motor.registrar_nodo(11, "Puerta Abierta", 125,  75,  35, 0)
    motor.registrar_nodo(12, "Antorcha",       255, 200,  50, 0)
    motor.registrar_nodo(13, "Semilla",         95, 195,  65, 0)
    motor.registrar_nodo(14, "Dinamita TNT",   220,  40,  40, 1)
    motor.registrar_nodo(15, "Nieve",          235, 242, 250, 0)
    motor.registrar_nodo(16, "Cactus",          50, 160,  75, 1)
    motor.registrar_nodo(17, "Hielo",          145, 210, 245, 0)
    motor.registrar_nodo(18, "Basalto",         55,  52,  62, 0)
    motor.registrar_nodo(19, "Cristal Rubí",   230,  45, 135, 1)

    // 2. Bloques emisores de luz nocturna
    motor.nodo_luz(7,  4)
    motor.nodo_luz(12, 7)
    motor.nodo_luz(14, 4)
    motor.nodo_luz(19, 5)

    // 3. Dotación inicial de recursos en el inventario
    motor.inv_agregar(1,  15)
    motor.inv_agregar(4,  10)
    motor.inv_agregar(5,  20)
    motor.inv_agregar(6,  10)
    motor.inv_agregar(8,  25)
    motor.inv_agregar(9,  15)
    motor.inv_agregar(10,  4)
    motor.inv_agregar(12, 10)
    motor.inv_agregar(13, 10)
    motor.inv_agregar(14, 10)
    motor.inv_agregar(19,  5)

    motor.ui_titulo("LatinoUI Studio v0.8")

    // ------------------------------------------------------------------------
    // PESTAÑA 1: CONSTRUIR
    // ------------------------------------------------------------------------
    motor.ui_pestana(0, "Construir")

    motor.ui_etiqueta("-- Herramienta y Pincel --")
    motor.ui_interruptor(304, "Modo Creativo (Infinito)", 0)
    motor.ui_deslizador(300, "Tamaño de Brocha", 1, 5, 1)
    motor.ui_boton(25, "Tender Puente Aquí [Tecla E]", 170, 120, 70)
    motor.ui_ayuda(25, "Construye un puente de madera de 3x3 sobre el agua o lava cercana.")

    motor.ui_etiqueta("-- Paleta de Bloques --")
    motor.ui_boton(8,  "8: Puente / Madera",   170, 120,  70)
    motor.ui_boton(9,  "9: Muro de Ladrillo",  165,  65,  55)
    motor.ui_boton(10, "0: Puerta [Tecla E]",  125,  75,  35)
    motor.ui_boton(12, "T: Antorcha de Luz",   215, 155,  20)
    motor.ui_boton(13, "Y: Semilla (Crece)",    75, 165,  50)
    motor.ui_boton(14, "U: Dinamita TNT [E]",  205,  40,  40)
    motor.ui_boton(1,  "1: Piedra Sólida",     105, 110, 120)
    motor.ui_boton(5,  "5: Camino de Tierra",  190, 155, 110)
    motor.ui_boton(19, "Cristal Rubí (Luz)",   200,  40, 120)

    motor.ui_etiqueta("-- Carteles y Fortaleza --")
    motor.ui_caja_texto(100, "Texto del Cartel:", "¡Fortaleza de Mario en Español!")
    motor.ui_boton(15, "Instalar Cartel Aquí", 145,  95,  50)
    motor.ui_boton(20, "Construir Cabaña 5x5", 140,  70, 175)

    // ------------------------------------------------------------------------
    // PESTAÑA 2: ARTESANÍA (CRAFTING)
    // ------------------------------------------------------------------------
    motor.ui_pestana(1, "Artesanía")

    motor.ui_etiqueta("-- Tu Inventario Actual --")
    motor.ui_resumen_inv()

    motor.ui_etiqueta("-- Recetas de Fabricación --")
    motor.ui_boton(70, "+6 Puentes Madera (1 Árbol)",       170, 120,  70)
    motor.ui_boton(71, "+4 Antorchas (1 Árbol + 1 Piedra)", 210, 150,  25)
    motor.ui_boton(72, "+4 Ladrillos (2 Piedra + 1 Arena)", 165,  65,  55)
    motor.ui_boton(73, "+2 Puertas (Usa 2 Madera)",         125,  75,  35)
    motor.ui_boton(76, "+4 Semillas (Usa 1 Árbol)",          75, 165,  50)
    motor.ui_boton(77, "+3 Dinamita TNT (1 Arena+1 Piedra)",205,  40,  40)
    motor.ui_boton(78, "Poción Curativa (+50 Vida: 1 Cristal)", 200, 40, 95)
    motor.ui_boton(75, "Kit de Suministros (+20 Todo)",      45, 140,  95)

    // ------------------------------------------------------------------------
    // PESTAÑA 3: EJÉRCITO DE GÓLEMS Y COMBATE
    // ------------------------------------------------------------------------
    motor.ui_pestana(2, "Gólems/IA")

    motor.ui_etiqueta("-- Crear Gólems a Gusto [Tecla V] --")
    motor.ui_boton(200, "Invocar +1 Gólem Aquí [V]",         40, 135, 185)
    motor.ui_boton(205, "Invocar Escuadrón (+5 Gólems)",     35, 155, 145)
    motor.ui_boton(206, "Invocar Ejército (+20 Gólems)",    135,  60, 180)
    motor.ui_boton(207, "Reunir Todos los Gólems Aquí",      55, 110, 165)
    motor.ui_boton(208, "Desactivar / Limpiar Gólems",      130,  55,  60)

    motor.ui_etiqueta("-- Orden Global para los Gólems --")
    motor.ui_boton(201, "Orden: Escolta y Combatir Enemigos", 45, 150,  95)
    motor.ui_boton(202, "Orden: Talar y Minar Recursos",      35, 125,  60)
    motor.ui_boton(203, "Orden: Construir Puentes y Caminos",180, 125,  45)
    motor.ui_boton(204, "Orden: Detener Gólems (Espera)",    100,  75,  85)

    motor.ui_etiqueta("-- Enemigos y Combate [Atacar: Tecla F] --")
    motor.ui_interruptor(308, "Generación de Enemigos", 1)
    motor.ui_boton(220, "Invocar Oleada de Enemigos (x6)",   195,  45,  45)
    motor.ui_boton(221, "Curar Jugador al 100% HP",           45, 160,  80)
    motor.ui_boton(222, "Eliminar Todos los Enemigos",       120,  60,  70)

    // ------------------------------------------------------------------------
    // PESTAÑA 4: MUNDO GIGANTE (64x64 CHUNKS) Y 5 BIOMAS
    // ------------------------------------------------------------------------
    motor.ui_pestana(3, "Biomas")

    motor.ui_etiqueta("-- Viaje Rápido a Biomas (Mapa 1024x1024) --")
    motor.ui_boton(17, "Centro: Bosque Templado (512,512)",  45, 135,  75)
    motor.ui_boton(230, "Ir al Desierto Árido (720, 512)",  195, 165,  65)
    motor.ui_boton(231, "Ir a la Tundra Nevada (512, 240)",  75, 145, 195)
    motor.ui_boton(232, "Ir al Volcán de Lava (280, 512)",  185,  55,  35)
    motor.ui_boton(233, "Ir al Pantano Místico (512, 780)",  85,  70, 145)

    motor.ui_etiqueta("-- Ciclo Día / Noche --")
    motor.ui_interruptor(305, "Reloj Día/Noche Auto", 1)
    motor.ui_deslizador(306, "Hora del Día (0-24h)", 0, 24, 10)
    motor.ui_boton(80, "Fijar Mediodía (12:00h)",     55, 145, 205)
    motor.ui_boton(81, "Fijar Medianoche (00:00h)",   35,  45,  95)

    motor.ui_etiqueta("-- Exploración (4096 Chunks Totales) --")
    motor.ui_progreso(400, "Regiones Exploradas", 9, 4096)
    motor.ui_interruptor(303, "Mostrar Minimapa 2D", 1)
    motor.ui_interruptor(301, "Ver Rejilla Chunks", 0)

    motor.ui_etiqueta("-- Semilla Procedural --")
    motor.ui_caja_texto(101, "Semilla (Número):", "2026")
    motor.ui_boton(16, "Regenerar Universo", 45, 130, 115)

    // ------------------------------------------------------------------------
    // PESTAÑA 5: UX, AUDIO Y CONSOLA .LAT
    // ------------------------------------------------------------------------
    motor.ui_pestana(4, "UX / Dev")

    motor.ui_etiqueta("-- Herramientas de Desarrollador --")
    motor.ui_boton(90, "Consola .lat en Vivo [F3]",  155,  50, 145)

    motor.ui_etiqueta("-- Audio y Ergonomía --")
    motor.ui_interruptor(307, "Efectos de Sonido (Audio)", 1)
    motor.ui_interruptor(302, "Marcha Continua 1-Toque", 1)

    motor.ui_etiqueta("-- Temas Visuales (Frontend) --")

    // LatinoUI Layout experimental: dos botones comparten una fila.
    // Cada uno conserva su evento (50 y 51).
    motor.ui_iniciar_fila(8)
    motor.ui_boton(50, "Tema Oscuro", 45, 55, 75)
    motor.ui_boton(51, "Tema Claro", 150, 160, 175)
    motor.ui_fin_contenedor()

    motor.ui_boton(52, "Tema Esmeralda (Retro)", 25, 115, 85)

    // Posicionar en el centro del nuevo universo gigante (512, 512) y crear 3 Gólems iniciales
    motor.colocar_jugador(512, 512)
    motor.golem_crear(514, 512, 1)
    motor.golem_crear(510, 512, 1)
    motor.golem_crear(512, 514, 3)

    motor.poner_cartel(512, 510, "¡Bienvenido al Mundo Gigante v0.8 (1024x1024)! Pulsa [F] para atacar con espada, [V] para crear más Gólems y [E] para Puertas, TNT y Puentes.")
    motor.notificar("¡v0.8 Lista! Mundo 1024x1024 con 5 Biomas, Enemigos [F] y Gólems Ilimitados [V].")
fin

// ============================================================================
// MODO 2: REACTOR DE EVENTOS DE LA GUI, CRAFTING, BIOMAS Y EJÉRCITO DE GÓLEMS
// ============================================================================
si (modo == 2)
    id = motor.evento_id()

    si (id >= 1 && id <= 14)
        motor.seleccionar_bloque(id)
        motor.sonido(0)
        motor.notificar("Equipado: Bloque #" .. id .. " (Stock: " .. motor.inv_cantidad(id) .. ")")

    osi (id == 19)
        motor.seleccionar_bloque(19)
        motor.sonido(0)
        motor.notificar("Equipado: Cristal Rubí Luminoso (Stock: " .. motor.inv_cantidad(19) .. ")")

    osi (id == 15)
        texto_usuario = motor.ui_obtener_texto(100)
        px = motor.jugador_x()
        py = motor.jugador_y()
        motor.poner_cartel(px, py, texto_usuario)
        motor.sonido(1)
        motor.notificar("¡Cartel instalado: '" .. texto_usuario .. "'!")

    osi (id == 16)
        nueva_semilla = motor.ui_obtener_numero(101)
        motor.cambiar_semilla(nueva_semilla)
        motor.sonido(3)
        motor.notificar("¡Universo 1024x1024 regenerado con semilla " .. nueva_semilla .. "!")

    // Viajes rápidos a los 5 Biomas
    osi (id == 17)
        motor.colocar_jugador(512, 512)
        motor.sonido(0)
        motor.notificar("Bioma: Bosque Templado Central (512, 512)")

    osi (id == 230)
        motor.colocar_jugador(720, 512)
        motor.sonido(0)
        motor.notificar("Bioma: Desierto Árido (720, 512)")

    osi (id == 231)
        motor.colocar_jugador(512, 240)
        motor.sonido(0)
        motor.notificar("Bioma: Tundra Nevada (512, 240)")

    osi (id == 232)
        motor.colocar_jugador(280, 512)
        motor.sonido(0)
        motor.notificar("Bioma: Tierras Volcánicas (280, 512)")

    osi (id == 233)
        motor.colocar_jugador(512, 780)
        motor.sonido(0)
        motor.notificar("Bioma: Pantano Místico (512, 780)")

    // Tender puente inmediato
    osi (id == 25)
        motor.construir_puente()

    // Construir Cabaña 5x5 (Sin usar 'sino' dentro de 'mientras')
    osi (id == 20)
        px = motor.jugador_x()
        py = motor.jugador_y()
        dy = -2
        mientras (dy <= 2)
            dx = -2
            mientras (dx <= 2)
                motor.poner_casilla(px + dx, py + dy, 8)
                si (dx == -2)
                    motor.poner_casilla(px + dx, py + dy, 9)
                osi (dx == 2)
                    motor.poner_casilla(px + dx, py + dy, 9)
                osi (dy == -2)
                    motor.poner_casilla(px + dx, py + dy, 9)
                osi (dy == 2)
                    motor.poner_casilla(px + dx, py + dy, 9)
                fin
                dx = dx + 1
            fin
            dy = dy + 1
        fin
        motor.poner_casilla(px, py + 2, 10)
        motor.poner_casilla(px - 1, py - 1, 12)
        motor.poner_casilla(px + 1, py - 1, 12)
        texto_cabana = motor.ui_obtener_texto(100)
        motor.poner_cartel(px, py - 1, texto_cabana)
        motor.sonido(3)
        motor.notificar("¡Cabaña construida! Pulsa [E] cerca de la puerta sur para abrirla o cerrarla.")

    // --- RECETAS DE CRAFTING ---
    osi (id == 70)
        si (motor.inv_cantidad(4) >= 1)
            motor.inv_agregar(4, -1)
            motor.inv_agregar(8, 6)
            motor.seleccionar_bloque(8)
            motor.sonido(3)
            motor.notificar("¡Artesanía: +6 Bloques de Puente de Madera!")
        sino
            motor.sonido(5)
            motor.notificar("Necesitas 1 Tronco de Árbol.")
        fin

    osi (id == 71)
        si (motor.inv_cantidad(4) >= 1 && motor.inv_cantidad(1) >= 1)
            motor.inv_agregar(4, -1)
            motor.inv_agregar(1, -1)
            motor.inv_agregar(12, 4)
            motor.seleccionar_bloque(12)
            motor.sonido(3)
            motor.notificar("¡Artesanía: +4 Antorchas Luminosas!")
        sino
            motor.sonido(5)
            motor.notificar("Necesitas 1 Árbol y 1 Piedra.")
        fin

    osi (id == 72)
        si (motor.inv_cantidad(1) >= 2 && motor.inv_cantidad(6) >= 1)
            motor.inv_agregar(1, -2)
            motor.inv_agregar(6, -1)
            motor.inv_agregar(9, 4)
            motor.seleccionar_bloque(9)
            motor.sonido(3)
            motor.notificar("¡Artesanía: +4 Bloques de Ladrillo!")
        sino
            motor.sonido(5)
            motor.notificar("Necesitas 2 Piedras y 1 Arena.")
        fin

    osi (id == 73)
        si (motor.inv_cantidad(8) >= 2)
            motor.inv_agregar(8, -2)
            motor.inv_agregar(10, 2)
            motor.seleccionar_bloque(10)
            motor.sonido(3)
            motor.notificar("¡Artesanía: +2 Puertas Interactivas!")
        sino
            motor.sonido(5)
            motor.notificar("Necesitas 2 Tablones de Madera.")
        fin

    osi (id == 76)
        si (motor.inv_cantidad(4) >= 1)
            motor.inv_agregar(4, -1)
            motor.inv_agregar(13, 4)
            motor.seleccionar_bloque(13)
            motor.sonido(3)
            motor.notificar("¡Artesanía: +4 Semillas de Árbol!")
        sino
            motor.sonido(5)
            motor.notificar("Necesitas 1 Tronco de Árbol.")
        fin

    osi (id == 77)
        si (motor.inv_cantidad(6) >= 1 && motor.inv_cantidad(1) >= 1)
            motor.inv_agregar(6, -1)
            motor.inv_agregar(1, -1)
            motor.inv_agregar(14, 3)
            motor.seleccionar_bloque(14)
            motor.sonido(3)
            motor.notificar("¡Artesanía: +3 Cargas de Dinamita TNT!")
        sino
            motor.sonido(5)
            motor.notificar("Necesitas 1 Arena y 1 Piedra.")
        fin

    osi (id == 78)
        si (motor.inv_cantidad(19) >= 1)
            motor.inv_agregar(19, -1)
            motor.curar_jugador(50)
            motor.sonido(3)
            motor.notificar("¡Poción de Rubí bebida: +50 Puntos de Vida!")
        sino
            motor.sonido(5)
            motor.notificar("Necesitas 1 Cristal Rubí (Derrota enemigos o mina en el Volcán).")
        fin

    osi (id == 75)
        motor.inv_agregar(1, 20)
        motor.inv_agregar(4, 20)
        motor.inv_agregar(6, 20)
        motor.inv_agregar(8, 20)
        motor.inv_agregar(10, 10)
        motor.inv_agregar(12, 20)
        motor.inv_agregar(13, 20)
        motor.inv_agregar(14, 20)
        motor.inv_agregar(19, 10)
        motor.sonido(3)
        motor.notificar("¡Recibiste +20 de todos los materiales, Puentes, Puertas y TNT!")

    // --- CREACIÓN ILIMITADA DE GÓLEMS Y ÓRDENES ---
    osi (id == 200)
        px = motor.jugador_x()
        py = motor.jugador_y()
        motor.golem_crear(px + 1, py, motor.golem_tarea())
        motor.sonido(3)
        motor.notificar("🤖 ¡Nuevo Gólem creado! Total activos: " .. motor.golem_total())

    osi (id == 205)
        px = motor.jugador_x()
        py = motor.jugador_y()
        t_actual = motor.golem_tarea()
        i = 0
        mientras (i < 5)
            motor.golem_crear(px + (i - 2), py + 1, t_actual)
            i = i + 1
        fin
        motor.sonido(3)
        motor.notificar("🤖 ¡Escuadrón de +5 Gólems desplegado! Total: " .. motor.golem_total())

    osi (id == 206)
        px = motor.jugador_x()
        py = motor.jugador_y()
        t_actual = motor.golem_tarea()
        dy = -2
        mientras (dy <= 1)
            dx = -2
            mientras (dx <= 2)
                motor.golem_crear(px + dx, py + dy, t_actual)
                dx = dx + 1
            fin
            dy = dy + 1
        fin
        motor.sonido(3)
        motor.notificar("🤖 ¡Ejército de +20 Gólems desplegado! Total: " .. motor.golem_total())

    osi (id == 207)
        motor.golem_reunir()
        motor.sonido(3)
        motor.notificar("🤖 Todos tus Gólems se han reunido en tu posición.")

    osi (id == 208)
        motor.golem_limpiar()
        motor.sonido(0)
        motor.notificar("🤖 Todos los Gólems han sido retirados.")

    osi (id == 201)
        motor.golem_fijar_tarea(1)
        motor.sonido(0)
        motor.notificar("🤖 Orden Global: Escoltar al jugador y atacar enemigos.")

    osi (id == 202)
        motor.golem_fijar_tarea(2)
        motor.sonido(0)
        motor.notificar("🤖 Orden Global: Talar árboles y minar recursos.")

    osi (id == 203)
        motor.golem_fijar_tarea(3)
        motor.sonido(0)
        motor.notificar("🤖 Orden Global: Construir Puentes de Madera sobre el agua y caminos.")

    osi (id == 204)
        motor.golem_fijar_tarea(0)
        motor.sonido(0)
        motor.notificar("🤖 Orden Global: Gólems en espera.")

    // --- ENEMIGOS Y COMBATE ---
    osi (id == 220)
        motor.enemigo_oleada(6)
        motor.sonido(5)
        motor.notificar("⚔️ ¡Una oleada de 6 enemigos ha aparecido! Ataca con [F] o usa tus Gólems.")

    osi (id == 221)
        motor.curar_jugador(100)
        motor.sonido(3)
        motor.notificar("❤️ ¡Salud del jugador restaurada al 100%!")

    osi (id == 222)
        motor.enemigo_limpiar()
        motor.sonido(0)
        motor.notificar("🏳️ Todos los enemigos han sido eliminados del mapa.")

    // --- CONTROLES DE MUNDO Y UX ---
    osi (id == 80)
        motor.fijar_hora(12)
        motor.notificar("Reloj fijado al Mediodía (12:00h)")

    osi (id == 81)
        motor.fijar_hora(0)
        motor.notificar("Reloj fijado a Medianoche (00:00h)")

    osi (id == 90)
        motor.abrir_consola()

    osi (id == 300)
        motor.fijar_pincel(motor.ui_obtener_valor(300))

    osi (id == 301)
        motor.fijar_rejilla(motor.ui_obtener_valor(301))

    osi (id == 302)
        motor.fijar_marcha(motor.ui_obtener_valor(302))

    osi (id == 303)
        motor.fijar_minimapa(motor.ui_obtener_valor(303))

    osi (id == 304)
        motor.fijar_creativo(motor.ui_obtener_valor(304))

    osi (id == 305)
        motor.fijar_ciclo_luz(motor.ui_obtener_valor(305))

    osi (id == 306)
        motor.fijar_hora(motor.ui_obtener_valor(306))

    osi (id == 307)
        motor.fijar_audio(motor.ui_obtener_valor(307))

    osi (id == 308)
        motor.fijar_enemigos(motor.ui_obtener_valor(308))

    osi (id == 50)
        motor.ui_tema(0)

    osi (id == 51)
        motor.ui_tema(1)

    osi (id == 52)
        motor.ui_tema(2)

    osi (id == 60)
        motor.ui_modal("Guía v0.8: Biomas, Combate, Puentes y Gólems", "1) [E] abre/cierra Puertas al instante, detona TNT o tiende un Puente de Madera frente al agua.\n2) La Dinamita TNT también tiene mecha automática de 3 segundos al colocarla.\n3) Pulsa [F] para atacar enemigos con tu espada y [V] para invocar todos los Gólems que quieras.\n4) Explora los 5 Biomas desde la pestaña 'Biomas'.")
    fin
fin